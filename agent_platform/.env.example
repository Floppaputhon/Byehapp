# Required: master bot token from @BotFather (enable Business Mode if you want
# the master to also act as a Telegram Business assistant).
MASTER_BOT_TOKEN=

# Required: numeric Telegram user id of the platform owner. Only this user can
# manage sub-agents, integrations, and AI keys via the master bot. Get it from
# @userinfobot.
OWNER_ID=

# Required: master PIN used to derive the Fernet key that encrypts everything
# sensitive at rest (sub-agent tokens, AI API keys, integration tokens, vault
# entries). If you lose it you lose access to your stored secrets — keep it
# safe and identical across restarts.
MASTER_PIN=

# Optional: explicit DB path. Defaults to <package>/agent_platform.db.
DB_PATH=

# Optional: comma-separated list of provider ids whose keys you want to be
# allowed to fall back to environment variables (handy when you don't want to
# store them in the encrypted vault, e.g. during local development). Names use
# uppercase provider ids: OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY,
# OPENROUTER_API_KEY, GROQ_API_KEY, DEEPSEEK_API_KEY.
ENV_PROVIDERS=

# Optional: log level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
